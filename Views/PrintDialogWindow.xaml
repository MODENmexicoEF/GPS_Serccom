<Window x:Class="MahApps.Metro.Views.PrintDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MahApps.Metro.Views"
        mc:Ignorable="d"
        Title="PrintDialogWindow" Height="450" Width="800">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Configuración de Impresión" FontSize="16" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,15"/>

        <!-- Impresora Seleccionada -->
        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Text="Impresora Principal Destino:" FontWeight="SemiBold" FontSize="12" Foreground="#555" Margin="0,0,0,5"/>
            <TextBox Text="{Binding ImpresoraDestino}" IsReadOnly="True" Height="30" VerticalContentAlignment="Center" Background="#EFEFEF"/>
        </StackPanel>

        <!-- Número de Copias -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,20" VerticalAlignment="Center">
            <TextBlock Text="Número de Copias:" FontWeight="SemiBold" FontSize="12" Foreground="#555" VerticalAlignment="Center" Margin="0,0,15,0"/>
            <TextBox Text="{Binding NumeroCopias, Mode=TwoWay}" Width="60" Height="28" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
        </StackPanel>

        <!-- Botones de Acción -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancelar" Width="90" Height="30" Margin="0,0,10,0" Click="Cancelar_Click" Background="#E0E0E0" Foreground="#333"/>
            <Button Content="Imprimir" Width="100" Height="30" Click="Imprimir_Click" Background="#2ECC71" Foreground="White" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Window>
