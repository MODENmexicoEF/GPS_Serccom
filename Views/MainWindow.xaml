<Window x:Class="MahApps.Metro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:MahApps.Metro.ViewModels"
        xmlns:models="clr-namespace:MahApps.Metro.Models"
        mc:Ignorable="d"
        Title="Monitor de procesos WMI"
        Height="500"
        Width="850"
        Background="#F5F5F7">

    <!-- ViewModel -->
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <!-- Recursos visuales -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <!-- Interruptor estilo Android -->
        <Style x:Key="AndroidSwitch"
               TargetType="{x:Type CheckBox}">

            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#E5E7EB"/>
            <Setter Property="VerticalAlignment" Value="Center"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">

                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">

                            <Grid Width="42" Height="24">

                                <Border x:Name="Track"
                                        CornerRadius="12"
                                        Background="#555555"/>

                                <Ellipse x:Name="Thumb"
                                         Width="18"
                                         Height="18"
                                         Fill="White"
                                         HorizontalAlignment="Left"
                                         Margin="3"/>

                            </Grid>

                            <ContentPresenter ContentSource="Content"
                                              Margin="10,0,0,0"
                                              VerticalAlignment="Center"/>

                        </StackPanel>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsChecked" Value="True">

                                <Setter TargetName="Track"
                                        Property="Background"
                                        Value="#81C784"/>

                                <Setter TargetName="Thumb"
                                        Property="HorizontalAlignment"
                                        Value="Right"/>

                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">

                                <Setter Property="Opacity"
                                        Value="0.5"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>

        </Style>

    </Window.Resources>

    <Grid Margin="10">

        <TabControl>

            <!-- Pestaña 1: Monitor en vivo -->
            <TabItem Header="Monitor en vivo">

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Margin="10">

                    <StackPanel>

                        <TextBlock Text="Estado actual de procesos monitorizados"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#333"
                                   Margin="0,0,0,15"/>

                        <!-- Procesos padre -->
                        <!-- Procesos padre -->
                        <ItemsControl ItemsSource="{Binding ProcesosPadre}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="CardBorder"
                    Background="White"
                    CornerRadius="8"
                    Margin="0,0,0,10"
                    Padding="12"
                    BorderBrush="#E0E0E0"
                    BorderThickness="1.5">

                                        <Expander x:Name="ProcessExpander">
                                            <Expander.Header>
                                                <Grid Width="730">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="110"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Estado del proceso padre -->
                                                    <Border x:Name="StatusBadge"
                                    CornerRadius="12"
                                    Padding="8,4"
                                    HorizontalAlignment="Left">
                                                        <TextBlock Text="{Binding EstadoGeneral}"
                                           Foreground="White"
                                           FontWeight="Bold"
                                           FontSize="11"
                                           HorizontalAlignment="Center"/>
                                                    </Border>

                                                    <!-- Nombre y contador -->
                                                    <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        Margin="15,0,0,0">
                                                        <TextBlock Text="{Binding Nombre}"
                                           FontWeight="Bold"
                                           FontSize="14"
                                           Foreground="#2C3E50"/>
                                                        <TextBlock Text=" (Activos: "
                                           Foreground="Gray"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           Margin="10,0,0,0"/>
                                                        <TextBlock Text="{Binding CantidadActivos}"
                                           Foreground="Gray"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           FontWeight="Bold"/>
                                                        <TextBlock Text=")"
                                           Foreground="Gray"
                                           FontSize="12"
                                           VerticalAlignment="Center"/>
                                                    </StackPanel>

                                                    <!-- INTERRUPTOR DE CORREO PARA EL PROCESO PADRE -->
                                                    <CheckBox Grid.Column="2"
                                      Content="Correo"
                                      Style="{StaticResource AndroidSwitch}"
                                      IsChecked="{Binding NotificacionesHabilitadas, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      VerticalAlignment="Center"
                                      ToolTip="Activa o desactiva las notificaciones por correo para este proceso padre."/>
                                                </Grid>
                                            </Expander.Header>

                                            <!-- Instancias y subprocesos (SIN INTERRUPTOR) -->
                                            <StackPanel Margin="0,15,0,5">
                                                <Separator Background="#E0E0E0" Margin="0,0,0,10"/>
                                                <TextBlock Text="Instancias y Subprocesos Activos:"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#555"
                                   Margin="0,0,0,5"/>

                                                <ItemsControl ItemsSource="{Binding SubProcesos}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="#F9F9FB"
                                            CornerRadius="6"
                                            Padding="8"
                                            Margin="0,0,0,5"
                                            BorderBrush="#EFEFEF"
                                            BorderThickness="1">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="80"/>
                                                                        <ColumnDefinition Width="80"/>
                                                                        <ColumnDefinition Width="80"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                    </Grid.ColumnDefinitions>

                                                                    <!-- Hora -->
                                                                    <TextBlock Text="{Binding HoraEvento, StringFormat={}{0:HH:mm:ss}}"
                                                       Foreground="Gray"
                                                       FontSize="11"
                                                       VerticalAlignment="Center"/>

                                                                    <!-- PID -->
                                                                    <TextBlock Grid.Column="1"
                                                       Text="{Binding ProcessId}"
                                                       FontWeight="SemiBold"
                                                       FontSize="11"
                                                       VerticalAlignment="Center"/>

                                                                    <!-- Parent PID -->
                                                                    <TextBlock Grid.Column="2"
                                                       Text="{Binding ParentId}"
                                                       Foreground="Gray"
                                                       FontSize="11"
                                                       VerticalAlignment="Center"/>

                                                                    <!-- Tipo -->
                                                                    <TextBlock Grid.Column="3"
                                                       Text="{Binding TipoProceso}"
                                                       FontSize="11"
                                                       Foreground="#333"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Expander>
                                    </Border>

                                    <!-- Triggers de colores del padre -->
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding EstadoGeneral}" Value="{x:Static models:EstadoProceso.Iniciado}">
                                            <Setter TargetName="StatusBadge" Property="Background" Value="#2ECC71"/>
                                            <Setter TargetName="CardBorder" Property="BorderBrush" Value="#2ECC71"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding EstadoGeneral}" Value="{x:Static models:EstadoProceso.Detenido}">
                                            <Setter TargetName="StatusBadge" Property="Background" Value="#E74C3C"/>
                                            <Setter TargetName="CardBorder" Property="BorderBrush" Value="#E74C3C"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                </ScrollViewer>

            </TabItem>

            <!-- Pestaña 2: Configuración -->
            <!-- Pestaña 2: Configuración -->
            <TabItem Header="Configuración de Correos">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Gestión de Destinatarios de Alertas"
                   FontSize="16"
                   FontWeight="Bold"
                   Foreground="#333"/>

                    <!-- Formulario para agregar nuevo correo -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,15,0,15">
                        <TextBox Width="300"
                     Height="30"
                     Text="{Binding NuevoCorreoInput, UpdateSourceTrigger=PropertyChanged}"
                     VerticalContentAlignment="Center"
                     Padding="5,0"/>
                        <Button Content="Agregar Destinatario"
                    Margin="10,0,0,0"
                    Width="140"
                    Height="30"
                    Command="{Binding AgregarCorreoCommand}"
                    Background="#2C3E50"
                    Foreground="White"/>
                    </StackPanel>

                    <!-- Lista de destinatarios guardados en la DB -->
                    <Border Grid.Row="2"
                Background="White"
                CornerRadius="8"
                Padding="10"
                BorderBrush="#E0E0E0"
                BorderThickness="1">
                        <ListView ItemsSource="{Binding Destinatarios}"
                      BorderThickness="0"
                      Background="Transparent">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="ID" DisplayMemberBinding="{Binding Id}" Width="50"/>

                                    <!-- Columna de Correo Electrónico con cambio de color condicional a Rojo si IsActive es false -->
                                    <GridViewColumn Header="Correo Electrónico" Width="300">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Email}" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#333333"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                    <Setter Property="Foreground" Value="#E74C3C"/>
                                                                    <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <!-- Checkbox Activo/Inactivo interactivo -->
                                    <GridViewColumn Header="Activo" Width="80">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsActive, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Command="{Binding DataContext.CambiarEstadoCorreoCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                              CommandParameter="{Binding}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Center"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <!-- Botón Eliminar -->
                                    <GridViewColumn Header="Acciones" Width="100">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Eliminar"
                                            Command="{Binding DataContext.EliminarCorreoCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                            CommandParameter="{Binding}"
                                            Background="#E74C3C"
                                            Foreground="White"
                                            Width="80"
                                            Height="24"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Border>
                </Grid>
            </TabItem>
            <!-- Pestaña 3: Monitor y Visor de Facturas PDF -->
            <TabItem Header="Visor de Facturas">
                <Grid Margin="15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240" MinWidth="200"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="*" MinWidth="350"/>
                        <ColumnDefinition Width="350"/>
                    </Grid.ColumnDefinitions>

                    <!-- Columna 1: Lista de facturas -->
                    <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="10" BorderBrush="#E0E0E0" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Facturas Disponibles" FontSize="14" FontWeight="Bold" Foreground="#333" Margin="0,0,0,10"/>
                            <ListBox Grid.Row="1" ItemsSource="{Binding ListaFacturas}"
                         SelectedItem="{Binding FacturaSeleccionada, Mode=TwoWay}"
                         Background="Transparent" BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="5">
                                            <TextBlock Text="{Binding NombreArchivo}" FontWeight="SemiBold" Foreground="#2C3E50" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding FechaCreacion, StringFormat={}{0:dd/MM/yyyy HH:mm}}" FontSize="11" Foreground="Gray"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" Background="Transparent"/>

                    <!-- Columna 2: Vista previa con barra de herramientas -->
                    <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="10" BorderBrush="#E0E0E0" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Barra: páginas y zoom -->
                            <Border Background="#F9F9FB" CornerRadius="6" Padding="8" BorderBrush="#EFEFEF" BorderThickness="1" Margin="0,0,0,10">
                                <DockPanel LastChildFill="False">
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                        <Button Content="◀" Width="30" Height="26" Command="{Binding PaginaAnteriorCommand}"/>
                                        <TextBox Text="{Binding PaginaActual, UpdateSourceTrigger=LostFocus}"
                                     Width="40" Height="26" Margin="6,0"
                                     HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                                        <TextBlock Text="{Binding TotalPaginas, StringFormat='de {0}'}" VerticalAlignment="Center" Foreground="#555" Margin="0,0,6,0"/>
                                        <Button Content="▶" Width="30" Height="26" Command="{Binding PaginaSiguienteCommand}"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                        <Button Content="−" Width="30" Height="26" Command="{Binding ZoomMenosCommand}"/>
                                        <Slider Minimum="25" Maximum="300" Width="130" Margin="8,0"
                                    Value="{Binding ZoomPct, Mode=TwoWay}" VerticalAlignment="Center"/>
                                        <Button Content="+" Width="30" Height="26" Command="{Binding ZoomMasCommand}"/>
                                        <Button Content="{Binding ZoomPct, StringFormat={}{0:0}%}" Width="56" Height="26" Margin="6,0,0,0"
                                    Command="{Binding ZoomRestablecerCommand}" ToolTip="Restablecer a 100%"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- Visor -->
                            <ScrollViewer Grid.Row="1" Background="#E5E7EB"
                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="20" Background="White">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.3"/>
                                    </Border.Effect>
                                    <Image Source="{Binding VistaPrevia}"
                               Width="{Binding PreviewAncho}" Height="{Binding PreviewAlto}"
                               Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- Columna 3: Panel de impresión -->
                    <Border Grid.Column="3" Background="White" CornerRadius="8" Padding="12" Margin="10,0,0,0" BorderBrush="#E0E0E0" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Imprimir" FontSize="16" FontWeight="Bold" Foreground="#333" Margin="0,0,0,10"/>

                            <!-- Impresoras (cada una con su configuración) -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Impresoras}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#F9F9FB" CornerRadius="6" Padding="10" Margin="0,0,0,8"
                                        BorderBrush="#EFEFEF" BorderThickness="1">
                                                <StackPanel>
                                                    <CheckBox IsChecked="{Binding EstaSeleccionada, Mode=TwoWay}"
                                                  FontWeight="SemiBold" Foreground="#2C3E50">
                                                        <TextBlock Text="{Binding Nombre}" TextTrimming="CharacterEllipsis" MaxWidth="270"/>
                                                    </CheckBox>

                                                    <!-- Ajustes: solo si la impresora está marcada -->
                                                    <Grid Margin="0,10,0,0"
                                              Visibility="{Binding EstaSeleccionada, Converter={StaticResource BoolToVis}}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>

                                                        <TextBlock Text="Copias:" VerticalAlignment="Center" Margin="0,0,10,6" FontSize="12" Foreground="#555"/>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,6">
                                                            <TextBox Text="{Binding Copias, UpdateSourceTrigger=LostFocus}" Width="50" Height="26"
                                                         HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                                                            <CheckBox Content="Intercalar" IsChecked="{Binding Intercalar}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                                        </StackPanel>

                                                        <TextBlock Grid.Row="1" Text="Páginas:" VerticalAlignment="Center" Margin="0,0,10,6" FontSize="12" Foreground="#555"/>
                                                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,6">
                                                            <ComboBox SelectedIndex="{Binding ModoIndex}" Height="26">
                                                                <ComboBoxItem Content="Todas"/>
                                                                <ComboBoxItem Content="Página actual"/>
                                                                <ComboBoxItem Content="Rango..."/>
                                                            </ComboBox>
                                                            <TextBox Text="{Binding RangoTexto, UpdateSourceTrigger=PropertyChanged}" Height="26" Margin="0,4,0,0"
                                                         VerticalContentAlignment="Center" ToolTip="Ejemplo: 1,3,5-7"
                                                         Visibility="{Binding MostrarRango, Converter={StaticResource BoolToVis}}"/>
                                                        </StackPanel>

                                                        <TextBlock Grid.Row="2" Text="Papel:" VerticalAlignment="Center" Margin="0,0,10,6" FontSize="12" Foreground="#555"/>
                                                        <ComboBox Grid.Row="2" Grid.Column="1" Height="26" Margin="0,0,0,6"
                                                      ItemsSource="{Binding TamanosPapel}" SelectedItem="{Binding PapelSeleccionado}"/>

                                                        <TextBlock Grid.Row="3" Text="Color:" VerticalAlignment="Center" Margin="0,0,10,6" FontSize="12" Foreground="#555"/>
                                                        <CheckBox Grid.Row="3" Grid.Column="1" Content="Imprimir a color" Margin="0,0,0,6"
                                                      IsChecked="{Binding Color}" IsEnabled="{Binding SoportaColor}"/>

                                                        <TextBlock Grid.Row="4" Text="Dúplex:" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="12" Foreground="#555"/>
                                                        <ComboBox Grid.Row="4" Grid.Column="1" Height="26"
                                                      SelectedIndex="{Binding DuplexIndex}" IsEnabled="{Binding PuedeDuplex}">
                                                            <ComboBoxItem Content="Una sola cara"/>
                                                            <ComboBoxItem Content="Ambas caras (borde largo)"/>
                                                            <ComboBoxItem Content="Ambas caras (borde corto)"/>
                                                        </ComboBox>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <!-- Opciones globales y botón -->
                            <StackPanel Grid.Row="2" Margin="0,10,0,0">
                                <TextBlock Text="Escala de impresión (todas las impresoras):" FontWeight="SemiBold" FontSize="12" Foreground="#555" Margin="0,0,0,5"/>
                                <ComboBox ItemsSource="{Binding ModosEscala}" SelectedIndex="{Binding ModoEscalaIndex}" Height="28" Margin="0,0,0,12"/>

                                <Button Content="Imprimir" Command="{Binding ImprimirFacturaCommand}"
                            IsEnabled="{Binding PuedeImprimir}"
                            Background="#2ECC71" Foreground="White" Height="38" FontWeight="Bold" FontSize="14"/>

                                <ProgressBar IsIndeterminate="True" Height="4" Margin="0,8,0,0"
                                 Visibility="{Binding Imprimiendo, Converter={StaticResource BoolToVis}}"/>
                                <TextBlock Text="{Binding EstadoImpresion}" Foreground="Gray" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

    </Grid>

</Window>